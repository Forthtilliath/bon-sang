# URL publique du site (SEO, sitemap, métadonnées OpenGraph)
# Obligatoire en production : `next build` échoue si la variable est absente.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Carte des collectes : fonds CARTO (sans clé). Rien à configurer.
# Styles utilisés : https://basemaps.cartocdn.com/gl/{voyager,dark-matter}-gl-style/style.json

# Base de l'API Carto de l'EFS (par défaut : https://oudonner.api.efs.sante.fr/carto-api/v3)
# À surcharger seulement pour pointer un miroir ou un mock ; vide = valeur par défaut.
EFS_COLLECTES_URL=""
